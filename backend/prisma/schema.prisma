generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model UserAuth {
  id          Int              @id @default(autoincrement())
  username    String           @unique
  password    String
  createdAt   DateTime?        @default(now()) @map("created_at")
  files       File[]           @relation("UserFiles")
  permissions FilePermission[] @relation("UserPermissions")

  @@map("users_auth")
}

model File {
  id           String           @id
  ownerId      Int              @map("owner_id")
  originalName String           @map("original_name")
  mimeType     String           @map("mime_type")
  size         Int
  storagePath  String           @map("storage_path")
  createdAt    DateTime?        @default(now()) @map("created_at")
  owner        UserAuth         @relation("UserFiles", fields: [ownerId], references: [id])
  permissions  FilePermission[]

  @@map("files")
}

model FilePermission {
  fileId    String    @map("file_id")
  userId    Int       @map("user_id")
  role      String
  createdAt DateTime? @default(now()) @map("created_at")
  file      File      @relation(fields: [fileId], references: [id])
  user      UserAuth  @relation("UserPermissions", fields: [userId], references: [id])

  @@id([fileId, userId])
  @@map("file_permissions")
}

model users_old {
  id         Int       @id @default(autoincrement())
  email      String    @unique(map: "sqlite_autoindex_users_old_1")
  password   String
  created_at DateTime? @default(now())

  @@ignore
}
