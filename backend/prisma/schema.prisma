generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model UserAuth {
  id          Int              @id @default(autoincrement())
  username    String           @unique(map: "sqlite_autoindex_users_auth_1")
  password    String
  createdAt   DateTime?        @default(now()) @map("created_at")
  files       File[]           @relation("UserFiles")
  permissions FilePermission[] @relation("UserPermissions")
  events      Event[]
  eventPermissions EventPermission[] @relation("UserEventPermissions")
  sessions    Session[]
  savedFlashcards SavedFlashcard[]
  calendarInsights CalendarInsight[]

  @@map("users_auth")
}

enum EventVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum FileType {
  NOTES
  PAST_YEAR_PAPER
  OTHER
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

model File {
  id           String           @id
  ownerId      Int              @map("owner_id")
  originalName String           @map("original_name")
  groupName    String?          @map("group_name")
  mimeType     String           @map("mime_type")
  size         Int
  fileType     FileType         @default(NOTES) @map("file_type")
  visibility   FileVisibility   @default(PRIVATE)
  storagePath  String           @map("storage_path")
  createdAt    DateTime?        @default(now()) @map("created_at")
  owner        UserAuth         @relation("UserFiles", fields: [ownerId], references: [id])
  permissions  FilePermission[]
  processingStatus String @default("pending") @map("processing_status")
  extractedText String? @map("extracted_text")
  processingError String? @map("processing_error")

  @@map("files")
}

model FilePermission {
  fileId    String    @map("file_id")
  userId    Int       @map("user_id")
  role      String
  createdAt DateTime? @default(now()) @map("created_at")
  file      File      @relation(fields: [fileId], references: [id])
  user      UserAuth  @relation("UserPermissions", fields: [userId], references: [id])

  @@id([fileId, userId])
  @@map("file_permissions")
}

model Event {
  id                String           @id @default(cuid())
  title             String
  startTime         DateTime         @map("start_time")
  endTime           DateTime         @map("end_time")
  notes             String?          @map("notes")
  color             String           @default("#3788d8") @map("color")
  visibility        EventVisibility  @default(PRIVATE)
  rrule             String?          @map("rrule")
  exdates           String?          @map("exdates")
  seriesId          String?          @map("series_id")
  ownerId           Int              @map("owner_id")
  createdAt         DateTime?        @default(now()) @map("created_at")
  updatedAt         DateTime?        @updatedAt @map("updated_at")

  owner       UserAuth          @relation(fields: [ownerId], references: [id])
  permissions EventPermission[]

  @@index([ownerId])
  @@index([seriesId])
  @@map("events")
}

model EventPermission {
  eventId   String    @map("event_id")
  userId    Int       @map("user_id")
  role      String
  createdAt DateTime? @default(now()) @map("created_at")

  event Event    @relation(fields: [eventId], references: [id])
  user  UserAuth @relation("UserEventPermissions", fields: [userId], references: [id])

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_permissions")
}

model users_old {
  id         Int       @id @default(autoincrement())
  email      String    @unique(map: "sqlite_autoindex_users_old_1")
  password   String
  created_at DateTime? @default(now())

  @@ignore
}

model Session {
  sessionId       Int       @id @default(autoincrement()) @map("session_id")
  userId          Int       @map("user_id")
  sessionTitle    String    @map("session_title")
  durationSeconds Int       @map("duration_seconds")
  focusLevel      Int       @map("focus_level")
  goals           String?
  remarks         String?
  progress        String?
  pausedCount     Int       @default(0) @map("paused_count")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  calendarEventId String?   @unique @map("calendar_event_id")
  aiInsightStatus String    @default("none") @map("ai_insight_status")
  aiInsight       String?   @map("ai_insight")
  aiInsightReason String?   @map("ai_insight_reason")
  aiInsightGeneratedAt DateTime? @map("ai_insight_generated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user UserAuth @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model SavedFlashcard {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  group     String   @map("group_name")
  front     String
  back      String
  createdAt DateTime @default(now()) @map("created_at")

  user UserAuth @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("saved_flashcards")
}

model CalendarInsight {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  
  observation     String
  concern         String?
  suggestion      String
  encouragement   String
  urgentActions   String?
  
  generatedAt     DateTime @default(now()) @map("generated_at")
  validUntil      DateTime @map("valid_until")
  
  eventsAnalyzed  Int      @map("events_analyzed")
  timeWindowStart DateTime @map("time_window_start")
  timeWindowEnd   DateTime @map("time_window_end")
  
  user            UserAuth @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([generatedAt])
  @@map("calendar_insights")
}